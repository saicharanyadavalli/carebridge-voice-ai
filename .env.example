# CareBridge Voice AI - Environment Configuration Example
# Copy this file to .env and fill in your keys. NEVER commit your actual .env file.

# LLM Provider selection: "openrouter", "nvidia", or "auto"
LLM_PROVIDER=auto

# OpenRouter Configuration (Optional if using NVIDIA or clinical fallback)
# Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# NVIDIA NIM Configuration (Optional if using OpenRouter or clinical fallback)
# Get a key from https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Application Language: "en" for English, "hi" for Hindi
APP_LANGUAGE=en

# Server Host & Port
HOST=0.0.0.0
PORT=5500

# CORS Allowed Origins (comma-separated, or * for all)
ALLOWED_ORIGINS=*
