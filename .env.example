# CareBridge Voice AI - Environment Configuration Example
# Copy this file to .env and fill in your keys. NEVER commit your actual .env file.

# Primary LLM Provider: "gemini" (default), "openrouter", "nvidia", or "auto"
LLM_PROVIDER=gemini

# Google Gemini Configuration (Default: gemini-2.5-flash)
# Get your Google AI Studio API keys from: https://aistudio.google.com/app/apikey
# You can provide 1, 2, or 3 Google API keys.
# CareBridge will automatically try Key 1 -> Key 2 -> Key 3 if any error/rate limit (429) occurs.
GEMINI_API_KEY=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter Configuration (Secondary Fallback if Gemini keys fail)
# Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# NVIDIA NIM Configuration (Tertiary Fallback if OpenRouter fails)
# Get a key from https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Application Language: "en" for English, "hi" for Hindi
APP_LANGUAGE=en

# Server Host & Port
HOST=0.0.0.0
PORT=5500

# CORS Allowed Origins (comma-separated, or * for all)
ALLOWED_ORIGINS=*

# Sarvam AI Voice Configuration (TTS & STT)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=simran_en_customer
SARVAM_STT_MODEL=saaras:v4
